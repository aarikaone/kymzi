# Copy to .env.build.local. Real credentials are ignored by Git.
# Kymzi app identifiers are com.kymzi.app on iOS and Android.

# Same Apple Developer team as Medinest (also the app.json default).
IOS_TEAM_ID=5Y3QHYUW35
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# Optional external cache, only while its drive is mounted:
# IOS_DERIVED_DATA_PATH=/Volumes/YourDrive/Kymzi-build-cache/ios/DerivedData
# IOS_SCHEME=Kymzi

# Your Kymzi Android upload key (never use Medinest's key).
KYMZI_ANDROID_KEYSTORE_PATH=
KYMZI_ANDROID_KEYSTORE_PASSWORD=
KYMZI_ANDROID_KEY_ALIAS=
KYMZI_ANDROID_KEY_PASSWORD=

# Local native tools, if they are not already configured:
# JAVA_HOME=/absolute/path/to/jdk-17/Contents/Home
# ANDROID_HOME=/Users/your-name/Library/Android/sdk
