{
  "expo": {
    "name": "Kymzi",
    "slug": "rymzi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rymzi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kymzi.app",
      "appleTeamId": "5Y3QHYUW35",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.kymzi.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "../../packages/assets/brand/kymzi-adaptive.png",
        "backgroundColor": "#171624",
        "monochromeImage": "../../packages/assets/brand/kymzi-monochrome.png"
      },
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "../../packages/assets/brand/kymzi-app-icon.png",
    "backgroundColor": "#090C0A",
    "plugins": [
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Share to Kymzi",
          "iosShareExtensionBundleIdentifier": "com.kymzi.app.share-extension",
          "iosAppGroupIdentifier": "group.com.kymzi.app",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kymzi to find your city for a place check-in. Your live location is never shared.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kymzi to take city photos. Photos are reviewed before you add them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of places you have visited to save memories and show them in your Home feed.",
          "cameraPermission": "Allow Kymzi to take city photos. Photos are reviewed before you add them.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning.cjs"
    ]
  }
}
