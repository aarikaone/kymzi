{
  "name": "rymzi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/core",
    "packages/cloud"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rymzi/web",
    "web": "npm run dev --workspace @rymzi/web",
    "build": "npm run build --workspace @rymzi/web",
    "typecheck": "npm run typecheck --workspace @rymzi/web && npm run typecheck --workspace @rymzi/mobile",
    "test": "node --experimental-strip-types --import ./scripts/catalogue-test-setup.ts --test packages/core/src/*.test.ts",
    "mobile": "node scripts/start-mobile.mjs",
    "ios": "npm run ios --workspace @rymzi/mobile --",
    "android": "npm run android --workspace @rymzi/mobile --",
    "test:ui": "npm run test --workspace @rymzi/web",
    "check": "npm test && npm run test:ui && npm run test:build && npm run typecheck && npm run build",
    "postinstall": "patch-package",
    "build:web": "npm run build",
    "build:android": "node scripts/build-mobile.mjs android",
    "build:android:apk": "node scripts/build-mobile.mjs android --apk",
    "build:android:debug": "node scripts/build-mobile.mjs android --debug",
    "build:ios": "node scripts/build-mobile.mjs ios",
    "build:ios:simulator": "node scripts/build-mobile.mjs ios --simulator",
    "build:all": "node scripts/build-mobile.mjs all",
    "build:doctor": "node scripts/build-mobile.mjs doctor",
    "build:bundles": "npm exec --workspace @rymzi/mobile -- expo export --platform all --output-dir ../../artifacts/native-export",
    "release:android": "node scripts/build-mobile.mjs android",
    "release:ios": "node scripts/build-mobile.mjs ios",
    "release:stores": "node build-store-releases.mjs",
    "test:build": "node --test scripts/mobile-build.test.mjs",
    "mobile:dev": "node scripts/start-mobile.mjs",
    "ios:dev": "node scripts/run-native.mjs ios --configuration Debug --device",
    "dev:place-art": "node scripts/place-art-server.mjs",
    "test:places": "node --test packages/core/src/place-checkins.test.ts scripts/place-art-server.test.mjs",
    "questions:build": "node scripts/generate-travel-questions.mjs",
    "catalog:build": "node scripts/build-world-catalogue.mjs",
    "catalog:validate": "node scripts/validate-world-catalogue.mjs",
    "art:prepare": "node scripts/prepare-world-art.mjs",
    "art:validate": "node scripts/prepare-world-art.mjs --check",
    "cloud:prepare": "node scripts/prepare-cloud-catalogue.mjs",
    "cloud:import": "node scripts/cloud-firestore-import.mjs",
    "cloud:deploy": "npm run build && firebase deploy --project kymzi-f1e9d --config firebase.json --only hosting,firestore:rules,firestore:indexes --non-interactive",
    "cloud:verify": "node scripts/cloud-firestore-import.mjs --verify",
    "test:cloud": "node --test scripts/cloud-catalogue.test.mjs",
    "cloud:verify-bundles": "node scripts/verify-cloud-bundles.mjs",
    "hosting:prepare": "npm run build && node scripts/prepare-firebase-hosting.mjs",
    "hosting:deploy": "npm run build && firebase deploy --project kymzi-f1e9d --config firebase.json --only hosting --non-interactive",
    "test:hosting": "node --test scripts/firebase-hosting.test.mjs",
    "images:publish": "node scripts/publish-storage-images.mjs",
    "test:storage": "node --test scripts/storage-images.test.mjs",
    "images:verify": "node scripts/verify-image-cdn.mjs",
    "images:deploy": "npm run cloud:prepare && npm run images:publish -- --apply && npm run images:verify && npm run cloud:import -- --apply",
    "art:bulk:prepare": "node scripts/world-art-run.mjs --prepare",
    "art:bulk:run": "node --env-file=.env.imagegen.local scripts/world-art-run.mjs --run",
    "art:bulk:status": "node scripts/world-art-run.mjs --status",
    "test:art-batch": "node --test scripts/world-art-batch.test.mjs scripts/world-art-run.test.mjs",
    "places:enrich": "node scripts/enrich-place-catalogue.mjs",
    "places:details:status": "node scripts/enrich-place-details.mjs --status",
    "test:place-details": "node --test scripts/place-details.test.mjs",
    "catalog:expand:validate": "node scripts/publish-destination-expansion.mjs",
    "catalog:expand:publish": "node scripts/publish-destination-expansion.mjs --apply",
    "catalog:expand:verify": "node scripts/publish-destination-expansion.mjs --verify",
    "test:destinations": "node --test scripts/destination-expansion.test.mjs",
    "art:destinations:prepare": "node scripts/destination-art.mjs --prepare",
    "art:destinations:run": "node --env-file=.env.imagegen.local scripts/destination-art.mjs --run",
    "art:destinations:status": "node scripts/destination-art.mjs --status",
    "test:destination-art": "node --test scripts/destination-art.test.mjs scripts/world-art-run.test.mjs scripts/storage-images.test.mjs"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "image-size": "^2.1.0",
    "@react-navigation/core": "7.21.13",
    "@react-navigation/elements": "2.9.39"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "pngjs": "^7.0.0"
  }
}
