{
  "name": "rymzi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rymzi/web",
    "web": "npm run dev --workspace @rymzi/web",
    "build": "npm run build --workspace @rymzi/web",
    "typecheck": "npm run typecheck --workspace @rymzi/web && npm run typecheck --workspace @rymzi/mobile",
    "test": "node --experimental-strip-types --test packages/core/src/*.test.ts",
    "mobile": "node scripts/start-mobile.mjs",
    "ios": "npm run ios --workspace @rymzi/mobile --",
    "android": "npm run android --workspace @rymzi/mobile --",
    "test:ui": "npm run test --workspace @rymzi/web",
    "check": "npm test && npm run test:ui && npm run test:build && npm run typecheck && npm run build",
    "postinstall": "patch-package",
    "build:web": "npm run build",
    "build:android": "node scripts/build-mobile.mjs android",
    "build:android:apk": "node scripts/build-mobile.mjs android --apk",
    "build:android:debug": "node scripts/build-mobile.mjs android --debug",
    "build:ios": "node scripts/build-mobile.mjs ios",
    "build:ios:simulator": "node scripts/build-mobile.mjs ios --simulator",
    "build:all": "node scripts/build-mobile.mjs all",
    "build:doctor": "node scripts/build-mobile.mjs doctor",
    "build:bundles": "npm exec --workspace @rymzi/mobile -- expo export --platform all --output-dir ../../artifacts/native-export",
    "release:android": "node scripts/build-mobile.mjs android",
    "release:ios": "node scripts/build-mobile.mjs ios",
    "release:stores": "node build-store-releases.mjs",
    "test:build": "node --test scripts/mobile-build.test.mjs",
    "mobile:dev": "node scripts/start-mobile.mjs",
    "ios:dev": "node scripts/run-native.mjs ios --configuration Debug --device"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "image-size": "^2.1.0",
    "@react-navigation/core": "7.21.13",
    "@react-navigation/elements": "2.9.39"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
